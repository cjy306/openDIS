+                         !std::isfinite(centers_b[i].z) || !std::isfinite(radii_b[i]) || radii_b[i] <= 0.0)
+                         throw py::value_error("Obstacle positions must be finite and radii positive");
+                     if (types[i] != OBSTACLE_OROWAN && types[i] != OBSTACLE_BREAKAWAY)
+                         throw py::value_error("Obstacle type must be 0 (Orowan) or 1 (breakaway)");
+                     if (!std::isfinite(phi_crit[i]) || phi_crit[i] <= 0.0 || phi_crit[i] > M_PI)
